{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diffy",
  "version": "0.0.0",
  "identifier": "com.diffy.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Diffy",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
